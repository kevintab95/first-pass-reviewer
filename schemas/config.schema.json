{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "repos": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[\\w.-]+\\/[\\w.-]+$"
      }
    },
    "select": {
      "default": {},
      "type": "object",
      "properties": {
        "assigned": {
          "default": true,
          "type": "boolean"
        },
        "reviewRequested": {
          "default": true,
          "type": "boolean"
        },
        "skipDraftPrs": {
          "default": true,
          "type": "boolean"
        },
        "labels": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipAuthors": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "default": {},
      "type": "object",
      "properties": {
        "type": {
          "default": "claude-code",
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "maxTurns": {
          "default": 40,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "timeoutMinutes": {
          "default": 20,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "prompt": {
      "default": {},
      "type": "object",
      "properties": {
        "template": {
          "type": "string"
        },
        "extraGuidance": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "context": {
      "default": {},
      "type": "object",
      "properties": {
        "checkout": {
          "default": true,
          "type": "boolean"
        },
        "ignore": {
          "default": [
            "**/package-lock.json",
            "**/yarn.lock",
            "**/pnpm-lock.yaml",
            "**/*.lock",
            "**/*.min.js",
            "**/*.min.css",
            "**/*.map",
            "**/*.snap"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "default": {},
      "type": "object",
      "properties": {
        "maxPrsPerRun": {
          "default": 5,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxFiles": {
          "default": 60,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxDiffLines": {
          "default": 4000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxComments": {
          "default": 15,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "issues": {
      "default": {},
      "type": "object",
      "properties": {
        "labels": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assignReviewer": {
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["reviewer", "repos"],
  "additionalProperties": false
}
